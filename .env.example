# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/scomap"

# Auth.js — générer avec `openssl rand -base64 32`.
# ⚠️ Ne JAMAIS réutiliser un secret de dev en production.
AUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Chiffrement des clés d'API providers (MapTiler, routing) stockées en base.
# En production, définir un secret DISTINCT d'AUTH_SECRET (rotation indépendante).
# Repli sur AUTH_SECRET si absent. ⚠️ Le faire tourner rend les clés déjà
# chiffrées illisibles (à re-saisir dans les paramètres du tenant).
# PROVIDER_KEYS_SECRET="generate-with-openssl-rand-base64-32"

# Inscription publique (désactivée par défaut — donne accès à toutes les
# données du tenant). Activer uniquement en dev/onboarding.
# ENABLE_PUBLIC_SIGNUP=true

# Optional: OAuth providers
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
